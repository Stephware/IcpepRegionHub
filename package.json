{
  "name": "icpep-region-3-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @icpep-region3-hub/web",
    "dev:api": "npm run start:dev --workspace @icpep-region3-hub/api",
    "db:seed": "npm run db:seed --workspace @icpep-region3-hub/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run test:e2e --workspace @icpep-region3-hub/api",
    "db:push": "npm run db:push --workspace @icpep-region3-hub/api",
    "db:setup": "npm run db:setup --workspace @icpep-region3-hub/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
